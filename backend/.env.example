# ==========================================
# Award Night Gala Platform - Production Environment Template
# Copy this file to .env and fill in your actual production secrets.
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL!
# ==========================================

# Application Environment
FLASK_ENV=production
FLASK_DEBUG=0
PORT=5000

# Security Keys (Generate strong random strings in production e.g. using `openssl rand -hex 32`)
SECRET_KEY=change_this_to_a_super_secret_random_string_in_production
JWT_SECRET_KEY=change_this_to_another_super_secret_jwt_key_in_production

# Domain & CORS Configuration
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com,https://admin.your-domain.com

# Database Configuration (PostgreSQL recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/award_db
# Or individual components:
POSTGRES_USER=award_user
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=award_db

# Admin Credentials (Used for initial setup)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_password_here

# Jeko Payment Aggregator Configuration
JEKO_API_KEY=your_jeko_api_key_here
JEKO_API_KEY_ID=your_jeko_api_key_id_here
JEKO_STORE_ID=your_jeko_store_id_here
JEKO_BASE_URL=https://api.jeko.africa/partner_api
JEKO_DOC_URL=https://developer.jeko.africa/

# SMTP Email Service Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM=your_email@gmail.com

# Infobip WhatsApp / OTP Configuration
INFOBIP_API_KEY=your_infobip_api_key_here
INFOBIP_BASE_URL=your_subdomain.api.infobip.com
OTP_TARGET_PHONE=225000000000
